# Signal Log — environment configuration
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# Never commit your real `.env` — it is gitignored on purpose.

# --- Required for AI headlines + summaries ---------------------------------
# Get a key at https://console.anthropic.com (API Keys).
# Without a valid key the site still runs, but shows original titles + a short
# preview instead of AI-written summaries.
# Paste as a single line, no quotes, no trailing spaces.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for summaries. Haiku is fast and cheap; switch to a Sonnet model
# for richer summaries at higher cost.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Refresh behavior -------------------------------------------------------
# Staleness window (minutes). When someone opens the site and the stored news is
# older than this, the visit triggers a refresh (with a progress bar). Fresher
# than this, the page loads instantly from cache. There is no background timer.
REFRESH_MINUTES=5

# Max new articles summarized per run (caps API cost per refresh).
MAX_NEW_PER_RUN=25

# Only keep stories newer than this many days.
MAX_AGE_DAYS=21

# --- Security ---------------------------------------------------------------
# Controls the MANUAL "Refresh" button only. When set, clicking Refresh requires
# this value in the x-admin-token header (the page prompts for it and remembers
# it for the session). The AUTOMATIC on-open refresh — the one that shows the
# progress bar when the news is stale — is always open and never needs a token,
# so visitors still get fresh news on load. Leave blank to make the button open
# too (local use). Generate a strong one with:  openssl rand -hex 32
ADMIN_TOKEN=

# --- Server -----------------------------------------------------------------
# Port the server listens on. On most hosts (Fly.io, Render) leave this at 3000.
PORT=3000
