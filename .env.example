# Signal Log — environment configuration
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# Never commit your real `.env` — it is gitignored on purpose.

# --- Required for AI headlines + summaries ---------------------------------
# Get a key at https://console.anthropic.com (API Keys).
# Without a valid key the site still runs, but shows original titles + a short
# preview instead of AI-written summaries.
# Paste as a single line, no quotes, no trailing spaces.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for summaries. Haiku is fast and cheap; switch to a Sonnet model
# for richer summaries at higher cost.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Refresh behavior -------------------------------------------------------
# How often the server checks the feeds for new stories (minutes).
REFRESH_MINUTES=30

# Max new articles summarized per run (caps API cost per refresh).
MAX_NEW_PER_RUN=25

# Only keep stories newer than this many days.
MAX_AGE_DAYS=21

# --- Security ---------------------------------------------------------------
# Optional but STRONGLY recommended for any public deployment. When set, the
# "Refresh" button requires this value in the x-admin-token header, so strangers
# can't trigger refreshes that spend your API credits. Leave blank for local use.
# Generate a strong one with:  openssl rand -hex 32
ADMIN_TOKEN=

# --- Server -----------------------------------------------------------------
# Port the server listens on. On most hosts (Fly.io, Render) leave this at 3000.
PORT=3000
